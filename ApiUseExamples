Raggiungi l'api con questo percorso:  http://crystalcharting.atwebpages.com/api.php

IMBARCAZIONI:

#Leggere tutte le barche (GET)

fetch('https://crystalcharting.awardspace.net/api.php?action=get_barche')
  .then(response => response.json())
  .then(data => console.log(data));

#Aggiungere una nuova barca (POST)

// Creiamo i dati esattamente come se fosse un form HTML
let dati = new FormData();
dati.append('action', 'add_barca');
dati.append('nomebarca', 'Galeone Reale');
dati.append('tipo', 'Vela');
dati.append('costo_giornaliero', '300.00');

fetch('https://crystalcharting.awardspace.net/api.php', {
    method: 'POST',
    body: dati
})
.then(response => response.text())
.then(risposta => {
    if(risposta === "OK") {
        alert("Barca aggiunta con successo!");
    } else {
        alert("Errore dal server: " + risposta);
    }
});

#Eliminare una barca (e di conseguenza le sue prenotazioni)

// Esempio: elimino l'imbarcazione con ID 1
fetch('https://crystalcharting.awardspace.net/api.php?action=delete_barca&id=1')
  .then(response => response.text())
  .then(risposta => {
      if(risposta === "OK") alert("Barca eliminata!");
  });

PRENOTAZIONI:

1. Leggere tutte le prenotazioni (GET)

fetch('https://crystalcharting.awardspace.net/api.php?action=get_prenotazioni')
  .then(response => response.json())
  .then(prenotazioni => {
      console.log("Elenco prenotazioni:", prenotazioni);
  });



2. Aggiungere una nuova prenotazione (POST)

let dati = new FormData();
dati.append('action', 'add_prenotazione');
dati.append('idBarca', '1'); // Assicurati che l'ID barca esista!
dati.append('data_checkin', '2026-08-01');  // Il database richiede AAAA-MM-GG
dati.append('data_checkout', '2026-08-10'); // Il database richiede AAAA-MM-GG
dati.append('email', 'cliente@email.it');
dati.append('nome_prenotazione', 'Marco Rossi');

fetch('https://crystalcharting.awardspace.net/api.php', {
    method: 'POST',
    body: dati
})
.then(response => response.text())
.then(risposta => {
    if(risposta === "OK") {
        alert("Prenotazione registrata!");
    } else {
        alert("Errore: " + risposta);
    }
});


3. Eliminare una prenotazione


// Esempio: elimino la prenotazione con ID 3
fetch('https://crystalcharting.atwebpages.com/api.php?action=delete_prenotazione&id=3')
  .then(response => response.text())
  .then(risposta => {
      if(risposta === "OK") alert("Prenotazione cancellata!");
  });
